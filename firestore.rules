rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Кітаптар
    match /books/{bookId} {
      allow read: if true;
      allow write: if true;
      
      // Пікірлер
      match /comments/{commentId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Өтінімдер (Leads)
    match /leads/{leadId} {
      allow read: if true;
      allow write: if true;
    }

    // Іс-шаралар (Events)
    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    // Баптаулар (Settings)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
